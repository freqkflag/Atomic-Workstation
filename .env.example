# Copy to .env for local development:
#   cp .env.example .env

# Atomic Gateway (OpenAI-compatible API on :4000)
ATOMIC_GATEWAY_MASTER_KEY=dev-master
ATOMIC_GATEWAY_URL=http://127.0.0.1:4000/v1

# Orchestrator vault — required for POST /api/vault/secrets
ATOMIC_VAULT_UNLOCKED=true
ATOMIC_MASTER_SECRET=dev-master-secret

# Data directory (PGlite)
ATOMIC_DATA_DIR=./data

# Service ports (optional)
ORCHESTRATOR_PORT=4310
PORT=4000
